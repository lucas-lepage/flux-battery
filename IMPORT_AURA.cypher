",soh:38,resistance:6.2,fault:"none",visual:"RAS visuel",battery:"BP-005"},{id:"BP-005-M4",soh:36,resistance:6.5,fault:"major",visual:"Anomalie signalée",battery:"BP-005"},{id:"BP-005-M5",soh:39,resistance:6.3,fault:"none",visual:"RAS visuel",battery:"BP-005"}] AS modules,
[{id:"MKT-01",name:"VTT électriques de seconde main",orientation:"Reuse",chemistry:"NMC",minSoh:80,urgency:95,active:true},{id:"MKT-02",name:"Atelier de remise à neuf",orientation:"Remanufacture",chemistry:"",minSoh:45,urgency:90,active:true},{id:"MKT-03",name:"Stockage pour bornes autoroutières",orientation:"Repurpose",chemistry:"LFP",minSoh:60,urgency:100,active:true},{id:"MKT-04",name:"Filière de valorisation matière",orientation:"Recycle",chemistry:"",minSoh:0,urgency:50,active:true}] AS markets,
[{id:"seed-BP-001",at:"2026-11-04T08:00:00.000Z",actor:"Constructeur",title:"Passeport créé",detail:"Jeu de données pédagogique · statut Original",battery:"BP-001"},{id:"seed-BP-002",at:"2026-11-04T08:00:00.000Z",actor:"Constructeur",title:"Passeport créé",detail:"Jeu de données pédagogique · statut Original",battery:"BP-002"},{id:"seed-BP-003",at:"2026-11-04T08:00:00.000Z",actor:"Constructeur",title:"Passeport créé",detail:"Jeu de données pédagogique · statut Original",battery:"BP-003"},{id:"seed-BP-004",at:"2026-11-04T08:00:00.000Z",actor:"Constructeur",title:"Passeport créé",detail:"Jeu de données pédagogique · statut Original",battery:"BP-004"},{id:"seed-BP-005",at:"2026-11-04T08:00:00.000Z",actor:"Constructeur",title:"Passeport créé",detail:"Jeu de données pédagogique · statut Original",battery:"BP-005"}] AS events
CALL {
 WITH batteries
 UNWIND batteries AS x
 MERGE (b:Battery {id:x.id})
 ON CREATE SET b.payload=x.payload,b.status=x.status,b.revision=0
 WITH b,x
 MERGE (p:Passport {id:x.id})
 MERGE (b)-[:HAS_PASSPORT]->(p)
 MERGE (a:Actor {id:x.owner})
 ON CREATE SET a.role='owner',a.name=x.owner
 MERGE (a)-[:RESPONSIBLE_FOR]->(p)
 RETURN count(*) AS batteries_verifiees
}
CALL {
 WITH modules
 UNWIND modules AS x
 MATCH (b:Battery {id:x.battery})
 MERGE (m:Module {id:x.id})
 ON CREATE SET m.soh=x.soh,m.resistance=x.resistance,m.fault=x.fault,m.visual=x.visual
 MERGE (b)-[:HAS_MODULE]->(m)
 RETURN count(*) AS modules_verifies
}
CALL {
 WITH markets
 UNWIND markets AS x
 MERGE (m:MarketDemand {id:x.id}) ON CREATE SET m += x
 RETURN count(*) AS demandes_verifiees
}
CALL {
 WITH events
 UNWIND events AS x
 MATCH (b:Battery {id:x.battery})
 MERGE (e:Event {id:x.id})
 ON CREATE SET e.at=x.at,e.actor=x.actor,e.title=x.title,e.detail=x.detail
 MERGE (b)-[:HAS_EVENT]->(e)
 RETURN count(*) AS evenements_verifies
}
RETURN batteries_verifiees,modules_verifies,demandes_verifiees,evenements_verifies;
